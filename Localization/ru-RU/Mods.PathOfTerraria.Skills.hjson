  # Эти строки используются для подсказки в панели быстрого доступа в NewHotbar.cs.
  LevelLine: (Уровень {0}/{1})
  ManaLine: Стоимость: {0} маны
  NotEnoughMana: Стоимость: [c/FF6666:{0} маны]
  WeaponLine: Требуется оружие {0}
  NoWeaponLine: Оружие не требуется
  NoKeybindLine: Не обнаружено назначение клавиши
  DurationLine: Длительность: {0} секунд
  CooldownLine: "Время восстановления: {0} секунд"
  KeybindLine: Нажмите {0}, чтобы использовать
  NeedsWeapon: Требуется держать предмет {0}
  BaseDamage: Наносит {0} базового урона
  # Эта строка используется для подсказки в меню умений.
  CantEquip: Невозможно оснастить умение: {0}

  Denials: {
    NotEnoughMana: "[c/999999:Недостаточно маны]"
    NeedsAffix: "[c/999999:Требуется сила префикса]"
  }

  # Эти строки являются фактическими локализациями для умений.
  Nova: {
    Name: Нова
    Description: Создайте ударную волну вокруг себя на основе урона вашего магического оружия
  }

  Berserk: {
    Name: Берсерк
    Description: Наносите на 150% больше урона, получая на 5 больше урона каждый раз при попадании
  }

  RainOfArrows: {
    Name: Залп
    Description: Выстрелите залпом снарядов на основе вашего дальнобойного оружия в сторону курсора после короткой задержки
  }

  MoltenShield: {
    Name: Расплавленный щит
    Description: Получите временный буфер здоровья, который останавливает 75% входящего урона, пока не будет сломан.
  }

  BloodSiphon: {
    Name: Кровососание
    Description: Потребляйте все ближайшие стеки Кровоточения, чтобы восстановить 3 здоровья за стек. Максимум 30 стеков.
  }

  FetidCarapace: {
    Name: Гнилой панцирь
    Description: Получите некоторые орбитальные снаряды, которые защищают вас от врагов и их снарядов.
  }

  Fireball: {
    Name: Фаербол
    Description: Заклинайте высокоповреждающий, взрывной фаербол, который имеет шанс поджечь врагов.
  }

  IceBolt: {
    Name: Ледяной заряд
    Description: Заклинайте ледяной заряд, который охлаждает любого врага, которого он поражает.
  }